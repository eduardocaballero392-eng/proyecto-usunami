# ── Servidor ─────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Base de datos (XAMPP) ────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=parrillita_app
DB_PASSWORD=
DB_NAME=parrillita

# ── Seguridad ────────────────────────────────────────────
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_MOZO_EXPIRES_IN=14h
# Orígenes permitidos (vacío = cualquiera de la red local)
CORS_ORIGINS=

# ── Impresoras ───────────────────────────────────────────
# mock = imprime en logs/impresiones-AAAA-MM-DD.log
# bluetooth = impresoras reales (Bluetooth, COM o TCP/IP)
PRINTER_MODE=mock
# IMPORTANTE: Para Bluetooth usar valores más altos (10000-15000ms)
# Para TCP/IP o COM pueden ser valores menores (5000ms)
PRINTER_TIMEOUT_MS=10000
PRINTER_MAX_RETRIES=3
PRINTER_RETRY_DELAY_S=30
# 42 caracteres para papel de 80 mm con fuente A (48 en algunos modelos)
PRINTER_WIDTH_CHARS=42
